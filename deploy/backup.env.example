# Restic repository — S3-compatible object storage
# s3:https://...
export RESTIC_REPOSITORY=

# Restic encryption password (keep safe, without it restore is impossible)
export RESTIC_PASSWORD=

# S3 credentials
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=

# H2 JDBC URL — must match DATABASE_URL in .env (AUTO_SERVER=TRUE allows backup connections)
export DATABASE_URL=jdbc:h2:file:/var/lib/roasti/data;AUTO_SERVER=TRUE

# Path to the application fat JAR (used as H2 classpath for backup)
export JAR_PATH=/usr/local/bin/roasti.jar
