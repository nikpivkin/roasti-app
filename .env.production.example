# Ktor server port
PORT=8080

# H2 JDBC database URL (AUTO_SERVER=TRUE allows the backup tool to connect while the app is running)
DATABASE_URL=jdbc:h2:file:/var/lib/roasti/data;AUTO_SERVER=TRUE

# Directory for user-uploaded files
UPLOADS_DIR=/var/lib/roasti/uploads

# Firebase — create a service account and base64-encode the JSON key:
#   base64 -w0 service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_CREDENTIALS_JSON_BASE64=
